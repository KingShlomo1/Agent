# Get your FREE Groq API key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional: route AI requests through a self-hosted CLIProxyAPI instance instead of
# calling Groq directly. When CLIPROXY_BASE_URL is set, GROQ_API_KEY and the browser
# key field are no longer required.
# CLIPROXY_BASE_URL=http://localhost:8317
# CLIPROXY_API_KEY=your-cliproxy-inbound-api-key
# CLIPROXY_MODEL=gemini-2.5-flash
